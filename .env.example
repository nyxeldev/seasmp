# ─── DATABASE ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seasmp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/seasmp_db"

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_URL="redis://:your_redis_password_here@localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=generate_64_char_hex_secret_here
JWT_REFRESH_SECRET=generate_64_char_hex_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── ENCRYPTION ──────────────────────────────────────────────────────────────
AES_ENCRYPTION_KEY=generate_64_char_hex_key_here

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# DISABLE_2FA_REQUIRED=true   # Uncomment for local dev to skip 2FA enforcement

# ─── PYTHON ANALYTICS ────────────────────────────────────────────────────────
ANALYTICS_PORT=5000
ANALYTICS_HOST=0.0.0.0
ANALYTICS_API_URL=http://localhost:5000

# ─── FRONTEND ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── NEXTAUTH ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_64_char_hex_secret_here
