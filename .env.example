# ─── DATABASE ────────────────────────────────────────────────────────────────
# DIQQAT: Postgres ikki xil portda ko'rinadi.
#   konteyner ichida : 5432  (compose o'zi DATABASE_URL ni shunday beradi)
#   host tomondan    : 5433  (docker-compose.yml: "5433:5432")
#
# 5433 ataylab tanlangan: ko'p kompyuterda 5432 da allaqachon mahalliy
# Postgres turadi va ikkalasi to'qnashardi.
#
# Quyidagi DATABASE_URL host tomonida ishlaydigan jarayonlar uchun: prisma
# CLI, migratsiya, seed va `npm run dev:api`. README dagi tartib aynan
# shunday — baza konteynerda, API esa hostda. Ilgari bu yerda 5432 turardi
# va toza o'rnatishda migratsiya "connection refused" bilan yiqilardi.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=seasmp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

DATABASE_URL="postgresql://postgres:your_password_here@localhost:5433/seasmp_db"

# Hammasi konteynerda ishlasa (docker compose up -d) bu qiymat ishlatilmaydi:
# compose api va analytics uchun DATABASE_URL ni postgres:5432 bilan almashtiradi.

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_URL="redis://:your_redis_password_here@localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=generate_64_char_hex_secret_here
JWT_REFRESH_SECRET=generate_64_char_hex_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── ENCRYPTION ──────────────────────────────────────────────────────────────
AES_ENCRYPTION_KEY=generate_64_char_hex_key_here

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# DISABLE_2FA_REQUIRED=true   # Uncomment for local dev to skip 2FA enforcement

# ─── XAVFSIZLIK ANIQLASH QATLAMLARI ──────────────────────────────────────────
# Har bir /v1/ so'rovida egalikni aniqlash, audit yozuvi va xatti-harakat
# tahlili bajariladi. Kutilmagan yuk yoki yolg'on ishoralar chiqsa, deployni
# qaytarmasdan shu yerdan o'chiriladi. DIQQAT: audit yozuvi ham to'xtaydi.
DETECTION_ENABLED=true

# ─── PYTHON ANALYTICS ────────────────────────────────────────────────────────
ANALYTICS_PORT=5000
ANALYTICS_HOST=0.0.0.0
ANALYTICS_API_URL=http://localhost:5000

# ─── FRONTEND ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ANALYTICS_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── NEXTAUTH ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_64_char_hex_secret_here
