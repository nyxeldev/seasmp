{
  "name": "@seasmp/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:all": "jest",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "db:migrate": "node scripts/with-env.js prisma migrate dev",
    "db:push": "node scripts/with-env.js prisma db push",
    "db:studio": "node scripts/with-env.js prisma studio",
    "db:seed": "node scripts/with-env.js tsx prisma/seed.ts",
    "db:generate": "node scripts/with-env.js prisma generate",
    "db:seed:demo": "node scripts/with-env.js tsx prisma/seed-demo.ts",
    "db:seed:history": "node scripts/with-env.js tsx prisma/seed-history.ts",
    "demo:behavior": "node scripts/with-env.js tsx src/tools/behaviorDemo.ts",
    "check:realtime": "node scripts/with-env.js tsx src/tools/realtimeCheck.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^8.14.0",
    "@prisma/client": "^6.0.0",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.3",
    "socket.io": "^4.2.0",
    "socket.io-client": "^4.8.4",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^6.0.0",
    "ts-jest": "^29.4.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.8.0"
  }
